# Base URL of the deployed Sahaaya API (see server/README or the root README's
# "Deploying" section). Include the /api suffix. Locally this defaults to
# http://localhost:4000/api if unset.
VITE_API_URL=https://your-sahaaya-api.onrender.com/api

# Voice Cloning Provider (optional, online-enhanced)
# Options: 'simulator' (default, no API key needed), 'elevenlabs', or 'xtts'
VITE_VOICE_CLONE_PROVIDER=simulator

# If using ElevenLabs:
# VITE_ELEVENLABS_API_KEY=your_elevenlabs_api_key_here

# If using Coqui XTTS-v2 self-hosted server:
# VITE_XTTS_ENDPOINT=http://localhost:8020

