# Groq AI engine (optional) — powers real AI-generated game recommendations
# and caregiver insight analysis. Without this key set, the app falls back
# to the existing rule-based engine (server/src/adaptive.ts) automatically —
# nothing breaks if you never configure this.
SAHAAYA_GROQ_API_KEY=

# Optional model override. Defaults to llama-3.1-8b-instant (fast + cheap,
# well-suited to short structured-JSON tasks) if unset.
# SAHAAYA_GROQ_MODEL=llama-3.1-8b-instant
